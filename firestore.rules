rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasRole(role) { return signedIn() && role in request.auth.token.roles; }
    function canReadCoverage() { return hasRole('coverage.read') || hasRole('admin'); }
    function canWriteData() { return hasRole('data.write') || hasRole('admin'); }

    match /meta/{document} {
      allow read: if signedIn();
      allow write: if canWriteData();
    }
    match /chunks/{document} {
      allow read: if signedIn();
      allow write: if canWriteData();
    }
    match /artifacts/{appId}/public/data/gtr_attendance/{document} {
      allow read, write: if signedIn();
    }
    match /artifacts/{appId}/public/data/gtr_codes/{document} {
      allow read: if signedIn();
      allow write: if hasRole('admin');
    }
    // Usuarios y roles viven en Firebase Authentication/Custom Claims,
    // no en documentos Firestore.
    match /users/{uid} {
      allow read, write: if false;
    }
  }
}
